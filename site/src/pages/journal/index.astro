---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/date";

const entries = await getCollection("journal", ({ data }) => data.draft !== true);
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout
  title="Journal"
  description="The historical record of Abbey Root's development, decisions, experiments, and lessons learned."
>
  <section>
    <p class="section-label">Abbey Root</p>
    <h1>Journal</h1>
    <p>
      The journal is Abbey Root’s continuous historical record. It includes the
      framework, lab, tooling, research, and the development of the sites that
      eventually became independent Abbey projects.
    </p>
  </section>

  <section>
    <h2>Journal Entries</h2>
    {entries.map((entry) => (
      <article>
        <h3><a href={`/journal/${entry.id}/`}>{entry.data.title}</a></h3>
        <p><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></p>
        {entry.data.description && <p>{entry.data.description}</p>}
      </article>
    ))}
  </section>
</Layout>
