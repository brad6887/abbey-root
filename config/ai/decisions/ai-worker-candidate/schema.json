{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation",
    "summary",
    "candidate_type",
    "proposed_command",
    "worker_objective",
    "why_ai_worker",
    "inputs",
    "deliverables",
    "validation",
    "human_boundary",
    "blocking_items",
    "evidence",
    "confidence",
    "alternatives",
    "assumptions"
  ],
  "properties": {
    "recommendation": { "type": "string" },
    "summary": { "type": "string" },
    "candidate_type": {
      "type": "string",
      "enum": ["research", "implementation", "none"]
    },
    "proposed_command": { "type": "string" },
    "worker_objective": { "type": "string" },
    "why_ai_worker": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deliverables": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation": {
      "type": "array",
      "items": { "type": "string" }
    },
    "human_boundary": { "type": "string" },
    "blocking_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "item"],
        "properties": {
          "document": { "type": "string" },
          "item": { "type": "string" }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason_not_selected"],
        "properties": {
          "item": { "type": "string" },
          "reason_not_selected": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
