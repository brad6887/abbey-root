{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation",
    "primary_backlog_item",
    "failure_mode",
    "blocking_items",
    "evidence",
    "recommendation_confidence",
    "implementation_confidence",
    "repository_review_required",
    "alternatives",
    "assumptions"
  ],
  "properties": {
    "recommendation": {
      "type": "string"
    },
    "primary_backlog_item": {
      "type": "string",
      "pattern": "^- \\[ \\] .+$"
    },
    "failure_mode": {
      "type": "string"
    },
    "blocking_items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^- \\[ \\] .+$"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document",
          "item"
        ],
        "properties": {
          "document": {
            "type": "string"
          },
          "item": {
            "type": "string"
          }
        }
      }
    },
    "recommendation_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "implementation_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.25
    },
    "repository_review_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "reason_not_selected"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "reason_not_selected": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
