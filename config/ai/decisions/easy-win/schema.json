{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation",
    "estimated_effort",
    "risk_level",
    "session_fit",
    "durable_value",
    "primary_backlog_item",
    "backlog_parents_closed",
    "completion_checkboxes",
    "required_subtasks",
    "optional_work_excluded",
    "new_backlog_items_expected",
    "expected_net_backlog_reduction",
    "blocking_items",
    "evidence",
    "recommendation_confidence",
    "implementation_confidence",
    "implementation_approach",
    "documented_implementation_details",
    "repository_review_required",
    "alternatives"
  ],
  "properties": {
    "recommendation": {
      "type": "string"
    },
    "estimated_effort": {
      "type": "string",
      "enum": [
        "small",
        "medium"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low"
      ]
    },
    "session_fit": {
      "type": "string"
    },
    "durable_value": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "primary_backlog_item": {
      "type": "string"
    },
    "backlog_parents_closed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^- \\[ \\] .+$"
      }
    },
    "completion_checkboxes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^- \\[ \\] .+$"
      }
    },
    "required_subtasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_work_excluded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "new_backlog_items_expected": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "expected_net_backlog_reduction": {
      "type": "integer",
      "minimum": 1
    },
    "blocking_items": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "document",
          "item"
        ],
        "properties": {
          "document": {
            "type": "string"
          },
          "item": {
            "type": "string"
          }
        }
      }
    },
    "recommendation_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "implementation_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.25
    },
    "implementation_approach": {
      "type": "string",
      "enum": [
        "unknown-pending-repository-review"
      ]
    },
    "documented_implementation_details": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      }
    },
    "repository_review_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "reason_not_selected"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "reason_not_selected": {
            "type": "string"
          }
        }
      }
    }
  }
}
