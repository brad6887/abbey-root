#!/usr/bin/env bash
# COMMAND: status
# DESCRIPTION: Show local Abbey Root status
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
ABBEY_TOOLKIT_ROOT="${ABBEY_TOOLKIT_ROOT:-$(cd "$SCRIPT_DIR/../.." && pwd)}"
ABBEY_ROOT="${ABBEY_ROOT:-$ABBEY_TOOLKIT_ROOT}"
STATUS_DIR="$ABBEY_TOOLKIT_ROOT/tools/status"

source "$STATUS_DIR/lib/output.sh"
source "$ABBEY_TOOLKIT_ROOT/tools/lib/project.sh"

echo "$(abbey_project_name "$ABBEY_ROOT") Status"
echo "Date: $(date)"
echo "Host: $(hostname)"
echo "Repo: $ABBEY_ROOT"

for check in "$STATUS_DIR"/checks/*.sh; do
  [[ -f "$check" ]] || continue
  source "$check"
done
