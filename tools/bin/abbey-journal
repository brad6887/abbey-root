#!/usr/bin/env bash
#
# Abbey Root Tool: abbey-journal
#
# Purpose:
#   Create or open an Abbey Root journal entry with valid Astro frontmatter.
#
# Usage:
#   abbey journal <journal title>
#   abbey journal --title "Journal Title"
#   abbey journal --no-edit --title "Journal Title"
#   abbey journal --help
#
set -euo pipefail

REPO_DIR="${ABBEY_ROOT:-$HOME/git/abbey-root}"
JOURNAL_DIR="$REPO_DIR/content/journal"

print_help() {
  cat <<'HELP'
Abbey Journal

Usage:
  abbey journal <journal title>
  abbey journal --title "Journal Title"
  abbey journal --no-edit --title "Journal Title"
  abbey journal --help

Creates or opens a dated Abbey Root journal entry.

Options:
  --title TITLE            Supply the complete journal title
  --no-edit                Create or report the entry without opening an editor
  -h, --help               Show this help

Examples:
  abbey journal Completing the Journal Platform
  abbey journal --title "Completing the Journal Platform"
  abbey journal --no-edit --title "Guided Session Capture Workflow"
HELP
}

TITLE=""
NO_EDIT=false
EXPLICIT_TITLE=false
POSITIONAL=()

while (($# > 0)); do
  case "$1" in
    -h|--help|help)
      print_help
      exit 0
      ;;

    --no-edit)
      NO_EDIT=true
      shift
      ;;

    --title)
      if [[ "$EXPLICIT_TITLE" == true ]]; then
        echo "FAIL --title may only be supplied once."
        exit 1
      fi

      if (($# < 2)) || [[ -z "${2:-}" || "${2:-}" == -* ]]; then
        echo "FAIL --title requires a value."
        echo
        print_help
        exit 1
      fi

      TITLE="$2"
      EXPLICIT_TITLE=true
      shift 2
      ;;

    -*)
      echo "FAIL Unknown option: $1"
      echo
      print_help
      exit 1
      ;;

    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ "$EXPLICIT_TITLE" == true && "${#POSITIONAL[@]}" -gt 0 ]]; then
  echo "FAIL Unexpected arguments after --title."
  echo "Quote multi-word titles as one argument."
  exit 1
fi

if [[ "$EXPLICIT_TITLE" == false ]]; then
  if [[ "${#POSITIONAL[@]}" -eq 0 ]]; then
    print_help
    exit 1
  fi

  TITLE="${POSITIONAL[*]}"
fi

DATE="$(date +%F)"
YEAR="$(date +%Y)"

SLUG="$(
  printf '%s\n' "$TITLE" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
)"

if [[ -z "$SLUG" ]]; then
  echo "FAIL Journal title does not produce a valid filename."
  exit 1
fi

FILE="$JOURNAL_DIR/$YEAR/$DATE-$SLUG.md"
RELATIVE_FILE="${FILE#$REPO_DIR/}"

mkdir -p "$JOURNAL_DIR/$YEAR"

if [[ ! -f "$FILE" ]]; then
  cat > "$FILE" <<EOF
---
title: "$TITLE"
description: "TODO: Add a short summary."
date: $DATE
draft: false
tags:
  - Abbey Root
---

# $TITLE

## Summary

TODO

## Accomplishments

- TODO

## Lessons Learned

- TODO

## Next Steps

- TODO

EOF

  echo "Journal entry created:"
  echo "$RELATIVE_FILE"
else
  echo "Journal entry already exists:"
  echo "$RELATIVE_FILE"
fi

if [[ "$NO_EDIT" == true ]]; then
  echo
  echo "Next:"
  echo "  Edit the journal entry, then run 'abbey review'."
  exit 0
fi

vi "$FILE"

echo
echo "Next step:"
echo "  abbey site build"
