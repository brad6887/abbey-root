#!/usr/bin/env bash
#
# Abbey Root Tool: abbey-journal
#
# Purpose:
#   Create or open an Abbey Root journal entry with valid Astro frontmatter.
#
# Usage:
#   abbey journal <journal title>
#   abbey journal --title "Journal Title"
#   abbey journal --help
#
set -euo pipefail

REPO_DIR="${ABBEY_ROOT:-$HOME/git/abbey-root}"
JOURNAL_DIR="$REPO_DIR/content/journal"

print_help() {
  cat <<'HELP'
Abbey Journal

Usage:
  abbey journal <journal title>
  abbey journal --title "Journal Title"
  abbey journal --help

Creates or opens a dated Abbey Root journal entry.

Examples:
  abbey journal Completing the Journal Platform
  abbey journal --title "Completing the Journal Platform"
HELP
}

case "${1:-}" in
  -h|--help|help)
    print_help
    exit 0
    ;;
esac

if (($# == 0)); then
  print_help
  exit 1
fi

case "$1" in
  --title)
    shift

    if (($# == 0)) || [[ -z "${1:-}" ]]; then
      echo "FAIL --title requires a value."
      echo
      print_help
      exit 1
    fi

    if (($# > 1)); then
      echo "FAIL Unexpected arguments after --title."
      echo "Quote multi-word titles as one argument."
      exit 1
    fi

    TITLE="$1"
    ;;

  -*)
    echo "FAIL Unknown option: $1"
    echo
    print_help
    exit 1
    ;;

  *)
    TITLE="$*"
    ;;
esac

DATE="$(date +%F)"
YEAR="$(date +%Y)"

SLUG="$(echo "$TITLE" \
  | tr '[:upper:]' '[:lower:]' \
  | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"

FILE="$JOURNAL_DIR/$YEAR/$DATE-$SLUG.md"

mkdir -p "$JOURNAL_DIR/$YEAR"

if [[ ! -f "$FILE" ]]; then
  cat > "$FILE" <<EOF
---
title: "$TITLE"
description: "TODO: Add a short summary."
date: $DATE
draft: false
tags:
  - Abbey Root
---

# $TITLE

## Summary

TODO

## Accomplishments

- TODO

## Lessons Learned

- TODO

## Next Steps

- TODO

EOF
fi

vi "$FILE"

echo
echo "Next step:"
echo "  abbey site build"
