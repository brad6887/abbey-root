#!/usr/bin/env bash
#
# Abbey Root Tool: abbey-site
#
# Purpose:
#   Build, manage, and publish the active Abbey project's site.
#
# Usage:
#   abbey site <command>
#
# Commands:
#   status        Show development server status.
#   build         Build the website.
#   publish       Build and publish the site to GitHub Pages.
#   start         Start the development server.
#   stop          Stop the development server.
#   restart       Restart the development server.
#
# Publish options:
#   --dry-run     Build and show what would be published without changing
#                 the production repository.
#
set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
ABBEY_TOOLKIT_ROOT="${ABBEY_TOOLKIT_ROOT:-$(cd "$SCRIPT_DIR/../.." && pwd)}"
ABBEY_ROOT="${ABBEY_ROOT:-$ABBEY_TOOLKIT_ROOT}"
PROJECT_LIB="$ABBEY_TOOLKIT_ROOT/tools/lib/project.sh"

# shellcheck source=../lib/project.sh
source "$PROJECT_LIB"

PROJECT_NAME="$(abbey_project_name "$ABBEY_ROOT")"
SITE_SOURCE="$(abbey_project_value "$ABBEY_ROOT" site.source "")"
BUILD_METHOD="$(abbey_project_value "$ABBEY_ROOT" site.build.method "")"
BUILD_OUTPUT="$(abbey_project_value "$ABBEY_ROOT" site.build.output "")"
PUBLISH_METHOD="$(abbey_project_value "$ABBEY_ROOT" site.publish.method "")"
PUBLISH_TARGET="$(abbey_project_value "$ABBEY_ROOT" site.publish.target "")"
PUBLISH_DOMAIN="$(abbey_project_value "$ABBEY_ROOT" site.publish.domain "")"

SITE_DIR=""
DIST_DIR=""
PRODUCTION_REPO=""
EXPECTED_CNAME="$PUBLISH_DOMAIN"
LIVE_SITE_URL=""
LOG_DIR="$ABBEY_ROOT/logs"
LOG_FILE="$LOG_DIR/abbey-site.log"
LIVE_SITE_VERIFY_ATTEMPTS="${ABBEY_SITE_VERIFY_ATTEMPTS:-10}"
LIVE_SITE_VERIFY_DELAY="${ABBEY_SITE_VERIFY_DELAY:-10}"

command="${1:-status}"
shift || true

print_header() {
  echo "========================================"
  echo " Abbey Site"
  echo "========================================"
  echo
}

resolve_project_path() {
  python3 - "$ABBEY_ROOT" "$1" <<'PY'
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
value = Path(sys.argv[2]).expanduser()
resolved = (root / value).resolve() if not value.is_absolute() else value.resolve()
try:
    resolved.relative_to(root)
except ValueError:
    raise SystemExit(f"FAIL Project site path is outside the active project: {resolved}")
print(resolved)
PY
}

resolve_target_path() {
  python3 - "$1" <<'PY'
import sys
from pathlib import Path
print(Path(sys.argv[1]).expanduser().resolve())
PY
}

load_build_configuration() {
  [[ -f "$ABBEY_ROOT/.abbey/project.yml" ]] ||
    fail "Active project has no metadata: $ABBEY_ROOT/.abbey/project.yml"
  [[ -n "$SITE_SOURCE" ]] || fail "Project has no site.source configuration."
  [[ -n "$BUILD_METHOD" ]] || fail "Project has no site.build.method configuration."

  SITE_DIR="$(resolve_project_path "$SITE_SOURCE")" || exit 1
  case "$BUILD_METHOD" in
    npm)
      [[ -n "$BUILD_OUTPUT" ]] || fail "npm site build requires site.build.output."
      DIST_DIR="$(resolve_project_path "$SITE_SOURCE/$BUILD_OUTPUT")" || exit 1
      ;;
    static)
      [[ -z "$BUILD_OUTPUT" || "$BUILD_OUTPUT" == "." ]] ||
        fail "static site build output must be '.' or omitted."
      DIST_DIR="$SITE_DIR"
      ;;
    *) fail "Unsupported site build method: $BUILD_METHOD" ;;
  esac
}

load_publish_configuration() {
  [[ -n "$PUBLISH_METHOD" ]] ||
    fail "Publishing refused: $PROJECT_NAME has no explicit site.publish configuration."
  [[ "$PUBLISH_METHOD" == "git-rsync" ]] ||
    fail "Unsupported site publishing method: $PUBLISH_METHOD"
  [[ -n "$PUBLISH_TARGET" ]] || fail "site.publish.target is required."
  [[ -n "$PUBLISH_DOMAIN" ]] || fail "site.publish.domain is required."
  PRODUCTION_REPO="$(resolve_target_path "$PUBLISH_TARGET")"
  LIVE_SITE_URL="https://$PUBLISH_DOMAIN/"
}

print_resolution() {
  echo "Resolved site configuration"
  echo "---------------------------"
  echo "Project:           $PROJECT_NAME ($ABBEY_ROOT)"
  echo "Source directory:  $SITE_DIR"
  echo "Target:            ${PRODUCTION_REPO:-$DIST_DIR}"
  echo "Domain:            ${PUBLISH_DOMAIN:-not configured}"
  echo "Deployment method: ${PUBLISH_METHOD:-none}"
  echo
}

fail() {
  echo "FAIL $*"
  exit 1
}

confirm() {
  local prompt="$1"
  local response

  read -r -p "$prompt [y/N] " response

  case "$response" in
    y|Y|yes|YES)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

require_command() {
  local required_command="$1"

  command -v "$required_command" >/dev/null 2>&1 ||
    fail "Required command not found: $required_command"
}

require_site_directory() {
  [[ -d "$SITE_DIR" ]] ||
    fail "Site directory not found: $SITE_DIR"
}

require_clean_source_repo() {
  if [[ -n "$(git -C "$ABBEY_ROOT" status --porcelain)" ]]; then
    echo "FAIL $PROJECT_NAME has uncommitted changes."
    echo
    git -C "$ABBEY_ROOT" status --short
    echo
    echo "Commit or discard the source changes before publishing."
    exit 1
  fi
}

require_production_repo() {
  [[ -d "$PRODUCTION_REPO/.git" ]] ||
    fail "Production repository not found: $PRODUCTION_REPO"

  if [[ -n "$(git -C "$PRODUCTION_REPO" status --porcelain)" ]]; then
    echo "FAIL Production repository has uncommitted changes."
    echo
    git -C "$PRODUCTION_REPO" status --short
    echo
    echo "Resolve the production changes before publishing."
    exit 1
  fi
}

validate_cname() {
  local cname_file="$PRODUCTION_REPO/CNAME"

  [[ -f "$cname_file" ]] ||
    fail "Production CNAME file not found: $cname_file"

  [[ "$(tr -d '\r\n' < "$cname_file")" == "$EXPECTED_CNAME" ]] ||
    fail "Unexpected production CNAME value"

  echo "OK   CNAME preserved: $EXPECTED_CNAME"
}

verify_live_site() {
  local attempt
  local curl_status
  local http_code

  if ! command -v curl >/dev/null 2>&1; then
    echo "WARN Live-site verification unavailable: curl not found"
    return 1
  fi

  if ! [[ "$LIVE_SITE_VERIFY_ATTEMPTS" =~ ^[1-9][0-9]*$ ]]; then
    echo "WARN Invalid ABBEY_SITE_VERIFY_ATTEMPTS: $LIVE_SITE_VERIFY_ATTEMPTS"
    return 1
  fi

  if ! [[ "$LIVE_SITE_VERIFY_DELAY" =~ ^[0-9]+$ ]]; then
    echo "WARN Invalid ABBEY_SITE_VERIFY_DELAY: $LIVE_SITE_VERIFY_DELAY"
    return 1
  fi

  echo
  echo "Live-site verification"
  echo "----------------------"
  echo "URL: $LIVE_SITE_URL"

  for ((attempt = 1; attempt <= LIVE_SITE_VERIFY_ATTEMPTS; attempt++)); do
    http_code="$(
      curl \
        -L \
        -sS \
        -o /dev/null \
        -w '%{http_code}' \
        --connect-timeout 5 \
        --max-time 15 \
        "$LIVE_SITE_URL" \
        2>/dev/null
    )"
    curl_status=$?

    if ((curl_status == 0)) && [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
      echo \
        "OK   Live site verified: HTTP $http_code" \
        "(attempt $attempt/$LIVE_SITE_VERIFY_ATTEMPTS)"
      return 0
    fi

    if ((curl_status != 0)); then
      echo \
        "INFO Verification attempt $attempt/$LIVE_SITE_VERIFY_ATTEMPTS" \
        "could not reach the live site."
    else
      echo \
        "INFO Verification attempt $attempt/$LIVE_SITE_VERIFY_ATTEMPTS" \
        "returned HTTP ${http_code:-unknown}."
    fi

    if ((attempt < LIVE_SITE_VERIFY_ATTEMPTS)); then
      sleep "$LIVE_SITE_VERIFY_DELAY"
    fi
  done

  echo \
    "WARN Live-site verification did not succeed after" \
    "$LIVE_SITE_VERIFY_ATTEMPTS attempts."
  return 1
}

site_pid() {
  pgrep -f "npm run dev|astro dev" | head -n 1
}

site_status() {
  local pid

  pid="$(site_pid || true)"

  if [[ -n "${pid:-}" ]]; then
    echo "OK   Site dev server running: PID $pid"
  else
    echo "WARN Site dev server not running"
  fi
}

site_build() {
  print_header
  load_build_configuration
  print_resolution
  require_site_directory
  case "$BUILD_METHOD" in
    npm)
      require_command npm
      (cd "$SITE_DIR" && npm run build)
      ;;
    static)
      [[ -f "$DIST_DIR/index.html" ]] || fail "Static site index not found: $DIST_DIR/index.html"
      echo "OK   Static site artifact ready: $DIST_DIR"
      ;;
  esac
  return 0
}

publish_rsync() {
  local dry_run="${1:-false}"
  local args=(
    -av
    --delete
    --exclude=.git/
    --exclude=CNAME
  )

  if [[ "$dry_run" == "true" ]]; then
    args+=(--dry-run)
  fi

  rsync "${args[@]}" "$DIST_DIR/" "$PRODUCTION_REPO/"
}

site_publish() {
  local dry_run=false
  local commit_message

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=true
        ;;
      -h|--help)
        cat <<'HELP'
Usage:
  abbey site publish
  abbey site publish --dry-run

The publish workflow:

  1. Resolves the active Abbey project from the current working directory.
  2. Requires explicit project-owned build and publish configuration.
  3. Requires clean source and production repositories.
  4. Builds or validates the configured site artifact.
  5. Shows the rsync changes.
  6. Preserves the production CNAME.
  7. Copies the generated site.
  8. Shows the production Git diff.
  9. Commits and pushes after confirmation.
  10. Verifies the live site after a successful push.

Environment:
  ABBEY_SITE_VERIFY_ATTEMPTS
      Number of live-site verification attempts.

      Default:
      10

  ABBEY_SITE_VERIFY_DELAY
      Seconds between verification attempts.

      Default:
      10
HELP
        return 0
        ;;
      *)
        fail "Unknown publish option: $1"
        ;;
    esac

    shift
  done

  print_header

  load_build_configuration
  load_publish_configuration
  print_resolution

  require_command git
  require_command rsync
  require_site_directory
  require_clean_source_repo
  require_production_repo
  validate_cname

  if [[ "$BUILD_METHOD" == "npm" ]]; then
    require_command npm
    echo "Building configured site..."
    (cd "$SITE_DIR" && npm run build) || fail "Site build failed"
  else
    echo "Validating configured static artifact..."
  fi

  [[ -f "$DIST_DIR/index.html" ]] ||
    fail "Generated index.html not found"

  echo
  echo "Publish preview"
  echo "---------------"
  publish_rsync true

  if [[ "$dry_run" == "true" ]]; then
    echo
    echo "DRY RUN complete. No production files were changed."
    return 0
  fi

  echo
  if ! confirm "Publish these generated files?"; then
    echo "Publish cancelled."
    return 0
  fi

  publish_rsync false
  validate_cname

  git -C "$PRODUCTION_REPO" add -A

  echo
  echo "Production changes"
  echo "------------------"

  git -C "$PRODUCTION_REPO" diff --cached --check ||
    fail "Production diff validation failed"

  git -C "$PRODUCTION_REPO" diff --cached --stat
  echo
  git -C "$PRODUCTION_REPO" status --short

  if git -C "$PRODUCTION_REPO" diff --cached --quiet; then
    echo
    echo "OK   Production site is already current."
    return 0
  fi

  echo
  if ! confirm "Commit and push the production site?"; then
    echo
    echo "Production files were updated but not committed."
    echo "Review or discard them in:"
    echo "  $PRODUCTION_REPO"
    return 0
  fi

  commit_message="Publish $PUBLISH_DOMAIN from $PROJECT_NAME $(git -C "$ABBEY_ROOT" rev-parse --short HEAD)"

  git -C "$PRODUCTION_REPO" commit -m "$commit_message"
  git -C "$PRODUCTION_REPO" push

  echo
  echo "OK   $PUBLISH_DOMAIN publish pushed successfully."

  if verify_live_site; then
    echo
    echo "OK   Publish and live-site verification complete."
    return 0
  fi

  echo
  echo "WARN Production push completed, but live-site verification failed."
  echo "INFO GitHub Pages may still be deploying the update."
  echo "INFO Recheck manually: $LIVE_SITE_URL"
  return 2
}

site_start() {
  local pid

  print_header
  load_build_configuration
  require_site_directory

  pid="$(site_pid || true)"

  if [[ -n "${pid:-}" ]]; then
    echo "OK   Site dev server already running: PID $pid"
    exit 0
  fi

  mkdir -p "$LOG_DIR"

  cd "$SITE_DIR" || exit 1
  nohup npm run dev -- --host 0.0.0.0 > "$LOG_FILE" 2>&1 &

  sleep 2
  site_status
  echo "LOG  $LOG_FILE"
}

site_stop() {
  local pid

  print_header

  pid="$(site_pid || true)"

  if [[ -z "${pid:-}" ]]; then
    echo "OK   Site dev server already stopped"
    exit 0
  fi

  echo "Stopping site dev server: PID $pid"
  pkill -f "npm run dev|astro dev" || true
  sleep 2
  site_status
}

site_restart() {
  "$0" stop
  echo
  "$0" start
}

case "$command" in
  build)
    site_build
    ;;

  publish)
    site_publish "$@"
    ;;

  start)
    site_start
    ;;

  stop)
    site_stop
    ;;

  restart)
    site_restart
    ;;

  status)
    print_header
    site_status
    ;;

  help|-h|--help)
    cat <<'HELP'
Abbey Site Tool

Usage:
  abbey site status              Show site development server status
  abbey site build               Build or validate the configured site artifact
  abbey site publish             Publish using explicit project configuration
  abbey site publish --dry-run   Preview publication without changing production
  abbey site start               Start the configured development server
  abbey site stop                Stop the development server
  abbey site restart             Restart the development server
HELP
    ;;

  *)
    echo "Unknown command: $command"
    echo
    echo "Run 'abbey site help' for available commands."
    exit 1
    ;;
esac
