#!/usr/bin/env bash
# COMMAND: doctor
# DESCRIPTION: Run Abbey Root health checks
set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
ABBEY_TOOLKIT_ROOT="${ABBEY_TOOLKIT_ROOT:-$(cd "$SCRIPT_DIR/../.." && pwd)}"
ABBEY_ROOT="${ABBEY_ROOT:-$ABBEY_TOOLKIT_ROOT}"
DOCTOR_DIR="$ABBEY_TOOLKIT_ROOT/tools/doctor"

source "$DOCTOR_DIR/lib/output.sh"
source "$DOCTOR_DIR/lib/platform.sh"
source "$ABBEY_TOOLKIT_ROOT/tools/lib/project.sh"

print_header "$(abbey_project_name "$ABBEY_ROOT") Doctor"

echo "Date: $(date)"
echo "Host: $(hostname)"
echo "Repo: $ABBEY_ROOT"
echo

if [[ -f "$ABBEY_ROOT/.abbey/project.yml" ]]; then
  infrastructure_default="false"
  internal_dns_default="false"
else
  infrastructure_default="true"
  internal_dns_default="true"
fi

for check in "$DOCTOR_DIR"/checks/*.sh; do
  [ -f "$check" ] || continue
  case "$(basename "$check")" in
    03-storage.sh|05-hosts.sh|06-backups.sh|08-remote-access.sh)
      if [[ "$(abbey_project_value "$ABBEY_ROOT" "capabilities.infrastructure" "$infrastructure_default")" != "true" ]]; then
        continue
      fi
      ;;
    09-dns.sh)
      if [[ "$(abbey_project_value "$ABBEY_ROOT" "capabilities.internal_dns" "$internal_dns_default")" != "true" ]]; then
        continue
      fi
      ;;
  esac
  source "$check"
done

print_summary
