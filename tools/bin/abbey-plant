#!/usr/bin/env bash
#
# Abbey Root Tool: abbey-plant
#
# Purpose:
#   Manage, validate, and publish plant workspaces.
#
# Usage:
#   abbey plant new <slug> --name NAME --type TYPE [options]
#   abbey plant validate <slug>
#   abbey plant publish <slug>
#   abbey plant publish-batch <slug> [slug ...]
#   abbey plant hero <slug>
#   abbey plant index <slug>
#   abbey plant update <slug>
#   abbey plant rename-exports <directory>
#   abbey plant update-batch <prepare|apply>
#

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
ABBEY_TOOLKIT_ROOT="${ABBEY_TOOLKIT_ROOT:-$(cd "$SCRIPT_DIR/../.." && pwd)}"
REPO_DIR="${ABBEY_ROOT:-$ABBEY_TOOLKIT_ROOT}"
PLANTS_DIR="$REPO_DIR/working/plants"
PROJECT_LIB="$ABBEY_TOOLKIT_ROOT/tools/lib/project.sh"
CONTENT_DIR=""
PUBLIC_PLANTS_DIR=""
PUBLICATION_MANIFEST_DIR=""
PUBLISH_TARGET_ROOT=""
IMAGE_DERIVATIVE_HELPER="$ABBEY_TOOLKIT_ROOT/tools/image/create_public_derivative.py"
BATCH_UPDATE_HELPER="$ABBEY_TOOLKIT_ROOT/scripts/abbey_plant_update_batch.py"
PLANT_TEMPLATE_DIR="$PLANTS_DIR/_template"

ok_count=0
warn_count=0
fail_count=0

# shellcheck source=../lib/project.sh
source "$PROJECT_LIB"

ok() {
    printf 'OK   %s\n' "$1"
    ((ok_count += 1))
}

warn() {
    printf 'WARN %s\n' "$1"
    ((warn_count += 1))
}

fail() {
    printf 'FAIL %s\n' "$1"
    ((fail_count += 1))
}

usage() {
    cat <<'USAGE'
Usage:
  abbey plant new <slug> --name NAME --type TYPE [options]
  abbey plant validate <slug>
  abbey plant publish <slug>
  abbey plant publish-batch <slug> [slug ...]
  abbey plant hero <slug> [--select NUMBER] [--yes]
  abbey plant index <slug> [--select NUMBER] [--yes]
  abbey plant update <slug> --photo FILE --narrative TEXT [options]
  abbey plant rename-exports <directory> [--dry-run]
  abbey plant update-batch prepare <directory> --date YYYY-MM-DD [--output FILE]
  abbey plant update-batch apply <worksheet> [--dry-run]

Commands:
  new         Create a plant workspace from the canonical template
  validate    Validate a plant workspace against the Plant Model
  publish     Generate Astro content and copy selected public images
  publish-batch
              Publish several plants serially in one validated workflow
  hero        Select the plant photograph assigned to the hero role
  index       Select the photograph used on plant index pages
  update      Add a dated observation and select its current photograph
  rename-exports
              Rename exported photos from XMP captions and capture dates
  update-batch
              Prepare or apply a reviewable multi-plant update worksheet

New options:
  --name NAME        Human-readable plant name (required)
  --type TYPE        Plant type, such as orchid (required)
  --status STATUS    Initial status (default: recovering)
  --date YYYY-MM-DD  Rescue and initial-status date (default: today)
  --photo FILE       Import an initial photograph (repeatable)

Update options:
  --photo FILE       Photograph to copy into the plant workspace
  --narrative TEXT   Short condition narrative
  --care TEXT        Optional care note
  --status STATUS    Optional new status
  --date YYYY-MM-DD  Observation date (default: today)
  --dry-run          Validate and show the proposed update without writing

Rename-exports options:
  --dry-run          Validate and preview every rename without writing

Update-batch workflow:
  prepare            Group renamed photos and create an editable worksheet
  apply              Validate and apply every completed worksheet update
USAGE
}

load_publish_target() {
    local target_project
    local expected_slug
    local expected_domain

    target_project="$(
        abbey_project_value "$REPO_DIR" exports.plants.target_project ""
    )"
    expected_slug="$(
        abbey_project_value "$REPO_DIR" exports.plants.target_project_slug ""
    )"
    expected_domain="$(
        abbey_project_value "$REPO_DIR" exports.plants.target_domain ""
    )"

    if [[ -z "$target_project" || -z "$expected_slug" || -z "$expected_domain" ]]; then
        echo "ERROR: Plant publishing requires explicit exports.plants target configuration."
        return 1
    fi

    IFS=$'\t' read -r PUBLISH_TARGET_ROOT CONTENT_DIR PUBLIC_PLANTS_DIR PUBLICATION_MANIFEST_DIR < <(
        python3 - "$REPO_DIR" "$target_project" "$expected_slug" "$expected_domain" <<'PY_TARGET'
import sys
from pathlib import Path

import yaml

source_root = Path(sys.argv[1]).resolve()
target_value = Path(sys.argv[2]).expanduser()
expected_slug = sys.argv[3]
expected_domain = sys.argv[4]
target_root = (
    (source_root / target_value).resolve()
    if not target_value.is_absolute()
    else target_value.resolve()
)
config_path = target_root / ".abbey" / "project.yml"


def error(message):
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(1)


if not config_path.is_file():
    error(f"Plant publishing target is not an Abbey project: {target_root}")

if target_root == source_root:
    error("Plant publishing target must be a separate Abbey project")

try:
    config = yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
except (OSError, yaml.YAMLError) as exc:
    error(f"Unable to load plant publishing target: {exc}")

project = config.get("project")
if not isinstance(project, dict) or project.get("slug") != expected_slug:
    actual = project.get("slug") if isinstance(project, dict) else None
    error(
        f"Plant publishing target slug is {actual!r}; expected {expected_slug!r}"
    )

publish = config.get("site", {}).get("publish", {})
if not isinstance(publish, dict) or publish.get("domain") != expected_domain:
    actual = publish.get("domain") if isinstance(publish, dict) else None
    error(
        f"Plant publishing target domain is {actual!r}; expected {expected_domain!r}"
    )

imports = config.get("imports", {}).get("plants", {})
if not isinstance(imports, dict):
    error("Target project must declare imports.plants")


def target_path(key):
    value = imports.get(key)
    if not isinstance(value, str) or not value.strip():
        error(f"Target project must declare imports.plants.{key}")
    path = Path(value)
    if path.is_absolute():
        error(f"imports.plants.{key} must be project-relative")
    resolved = (target_root / path).resolve()
    try:
        resolved.relative_to(target_root)
    except ValueError:
        error(f"imports.plants.{key} escapes the target project")
    return resolved


print(
    "\t".join(
        str(path)
        for path in (
            target_root,
            target_path("content"),
            target_path("public_images"),
            target_path("manifests"),
        )
    )
)
PY_TARGET
    ) || return 1

    if [[ -z "$PUBLISH_TARGET_ROOT" ]]; then
        echo "ERROR: Unable to resolve the plant publishing target."
        return 1
    fi
}

update_batch() {
    if [[ ! -f "$BATCH_UPDATE_HELPER" ]]; then
        echo "ERROR: Plant batch update helper is missing: $BATCH_UPDATE_HELPER"
        return 1
    fi

    python3 "$BATCH_UPDATE_HELPER" --root "$REPO_DIR" "$@"
}

rename_exports() {
    if [[ -x "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-media" ]]; then
        "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-media" rename-exports "$@"
        return $?
    fi

    # Compatibility fallback for partial toolkit installations predating
    # abbey media. The toolkit-owned media command is authoritative.
    local directory="${1:-}"

    if [[ -z "$directory" ]]; then
        echo "ERROR: Export directory is required."
        echo
        usage
        return 2
    fi

    shift
    local dry_run=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                dry_run=true
                shift
                ;;
            *)
                echo "ERROR: Unknown plant rename-exports option: $1"
                return 2
                ;;
        esac
    done

    if ! command -v exiftool >/dev/null 2>&1; then
        echo "ERROR: ExifTool is required to rename exported plant photos."
        return 1
    fi

    python3 - "$directory" "$dry_run" <<'PY'
import datetime
import os
import subprocess
import re
import sys
import uuid
from collections import defaultdict
from pathlib import Path

directory = Path(sys.argv[1]).expanduser().resolve()
dry_run = sys.argv[2] == "true"
image_suffixes = {".jpg", ".jpeg", ".heic", ".png", ".tif", ".tiff"}


def error(message, status=1):
    print(f"ERROR: {message}")
    raise SystemExit(status)


def metadata(tag, path):
    result = subprocess.run(
        ["exiftool", "-s3", tag, str(path)],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or f"ExifTool exited with status {result.returncode}"
        error(f"Could not read metadata from {path.name}: {detail}")
    return result.stdout.strip()


if not directory.is_dir():
    error(f"Export directory does not exist: {directory}")

images = sorted(
    (
        path
        for path in directory.iterdir()
        if path.is_file()
        and not path.name.startswith("._")
        and path.suffix.lower() in image_suffixes
    ),
    key=lambda path: (path.name.casefold(), path.name),
)
if not images:
    error(f"No supported photos found in: {directory}")

xmp_by_stem = defaultdict(list)
for path in directory.iterdir():
    if (
        path.is_file()
        and not path.name.startswith("._")
        and path.suffix.lower() == ".xmp"
    ):
        xmp_by_stem[path.stem.casefold()].append(path)

records = []
problems = []
for image in images:
    sidecars = xmp_by_stem[image.stem.casefold()]
    if not sidecars:
        problems.append(f"{image.name}: adjacent XMP sidecar is missing")
        continue
    if len(sidecars) > 1:
        names = ", ".join(sorted(path.name for path in sidecars))
        problems.append(f"{image.name}: multiple matching XMP sidecars found ({names})")
        continue

    sidecar = sidecars[0]
    caption = metadata("-XMP-dc:Description", sidecar)
    if not caption:
        problems.append(f"{sidecar.name}: XMP-dc:Description caption is missing")
        continue

    slug = re.sub(r"[^a-z0-9]+", "-", caption.lower()).strip("-")
    if not slug:
        problems.append(f"{sidecar.name}: caption does not contain filename-safe letters or numbers")
        continue

    date_text = metadata("-DateTimeOriginal", image)
    match = re.match(r"^(\d{4}):(\d{2}):(\d{2})(?:[ T].*)?$", date_text)
    if not match:
        problems.append(f"{image.name}: DateTimeOriginal is missing or invalid")
        continue
    try:
        capture_date = datetime.date(*(int(value) for value in match.groups()))
    except ValueError:
        problems.append(f"{image.name}: DateTimeOriginal is missing or invalid")
        continue

    records.append({
        "image": image,
        "sidecar": sidecar,
        "caption": caption,
        "slug": slug,
        "date": capture_date.isoformat(),
        "date_time": date_text,
    })

if problems:
    print("Plant Export Rename Validation")
    print("==============================")
    for problem in problems:
        print(f"FAIL {problem}")
    print(f"Result: validation failed; {len(problems)} problem(s); no files renamed")
    raise SystemExit(1)

groups = defaultdict(list)
for record in records:
    groups[(record["slug"], record["date"])].append(record)

for group in groups.values():
    group.sort(key=lambda record: (
        record["date_time"],
        record["image"].name.casefold(),
        record["image"].name,
    ))
    for index, record in enumerate(group, start=1):
        suffix = f"-{index:02d}" if len(group) > 1 else ""
        stem = f'{record["slug"]}-{record["date"]}{suffix}'
        record["image_target"] = directory / f'{stem}{record["image"].suffix.lower()}'
        record["sidecar_target"] = directory / f"{stem}.xmp"

sources = {record[key] for record in records for key in ("image", "sidecar")}
targets = [record[key] for record in records for key in ("image_target", "sidecar_target")]
duplicate_targets = sorted(
    {target for target in targets if targets.count(target) > 1},
    key=lambda path: path.name,
)
collisions = sorted(
    {target for target in targets if target.exists() and target not in sources},
    key=lambda path: path.name,
)
if duplicate_targets or collisions:
    for target in duplicate_targets:
        print(f"FAIL Multiple files would be renamed to: {target.name}")
    for target in collisions:
        print(f"FAIL Destination already exists: {target.name}")
    print("Result: validation failed; no files renamed")
    raise SystemExit(1)

print("Plant Export Rename")
print("===================")
print(f"Directory: {directory}")
for record in records:
    print(f'{record["image"].name} -> {record["image_target"].name}')
    print(f'{record["sidecar"].name} -> {record["sidecar_target"].name}')

if dry_run:
    print(f"Result: DRY RUN; {len(records)} photo pair(s) validated; no files renamed")
    raise SystemExit(0)

staged = []
try:
    for record in records:
        for source_key, target_key in (("image", "image_target"), ("sidecar", "sidecar_target")):
            source = record[source_key]
            target = record[target_key]
            if source == target:
                continue
            temporary = directory / f".abbey-rename-{uuid.uuid4().hex}"
            source.rename(temporary)
            staged.append((source, temporary, target))

    for source, temporary, target in staged:
        if target.exists():
            error(f"Destination appeared during rename: {target.name}")
        temporary.rename(target)
except BaseException:
    for source, temporary, target in reversed(staged):
        current = temporary if temporary.exists() else target
        if current.exists() and not source.exists():
            current.rename(source)
    raise

print(f"Result: renamed {len(records)} photo pair(s)")
PY
}

new_plant() {
    local slug="${1:-}"

    if [[ -z "$slug" ]]; then
        echo "ERROR: Plant slug is required."
        echo
        usage
        return 2
    fi

    shift

    local name=""
    local plant_type=""
    local status="recovering"
    local onboarding_date="$(date +%F)"
    local photos=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name|--type|--status|--date|--photo)
                if [[ $# -lt 2 ]]; then
                    echo "ERROR: $1 requires a value."
                    return 2
                fi
                case "$1" in
                    --name) name="$2" ;;
                    --type) plant_type="$2" ;;
                    --status) status="$2" ;;
                    --date) onboarding_date="$2" ;;
                    --photo) photos+=("$2") ;;
                esac
                shift 2
                ;;
            *)
                echo "ERROR: Unknown plant new option: $1"
                return 2
                ;;
        esac
    done

    if [[ -z "$name" || -z "$plant_type" ]]; then
        echo "ERROR: --name and --type are required."
        return 2
    fi

    local python_args=(
        "$PLANTS_DIR"
        "$PLANT_TEMPLATE_DIR"
        "$slug"
        "$name"
        "$plant_type"
        "$status"
        "$onboarding_date"
    )
    local photo
    for photo in "${photos[@]+"${photos[@]}"}"; do
        python_args+=("$photo")
    done

    python3 - "${python_args[@]}" <<'PY'
import datetime
import os
import re
import shutil
import sys
import tempfile
from pathlib import Path

import yaml

plants_dir = Path(sys.argv[1]).resolve()
template_dir = Path(sys.argv[2]).resolve()
slug = sys.argv[3]
name = sys.argv[4].strip()
plant_type = sys.argv[5].strip().lower()
status = sys.argv[6].strip().lower()
date_text = sys.argv[7]
photo_sources = [Path(value).expanduser().resolve() for value in sys.argv[8:]]
destination = plants_dir / slug


def error(message, exit_status=1):
    print(f"ERROR: {message}")
    raise SystemExit(exit_status)


if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", slug):
    error("Plant slug must contain lowercase letters, numbers, and single hyphens", 2)

if not name or not plant_type:
    error("--name and --type must not be empty", 2)

valid_statuses = {"recovering", "thriving", "blooming", "dormant", "deceased"}
if status not in valid_statuses:
    error("Status must be one of: " + ", ".join(sorted(valid_statuses)), 2)

try:
    onboarding_date = datetime.date.fromisoformat(date_text)
except ValueError:
    error(f"Date must use YYYY-MM-DD: {date_text}", 2)

if destination.exists():
    error(f"Plant workspace already exists: {destination}")

facts_template = template_dir / "facts.yaml"
required_template_files = (
    facts_template,
    template_dir / "story.md",
    template_dir / "history.md",
    template_dir / "inventory.md",
    template_dir / "photo-metadata.md",
)
for template_file in required_template_files:
    if not template_file.is_file():
        error(f"Plant template is incomplete: {template_file}")

seen_names = set()
photo_sidecars = {}
for source in photo_sources:
    if not source.is_file():
        error(f"Photo does not exist: {source}")
    if source.suffix.lower() not in {".jpg", ".jpeg", ".png", ".webp"}:
        error(f"Photo must be a JPG, PNG, or WebP image: {source}", 2)
    if source.name in seen_names:
        error(f"Initial photos have the same filename: {source.name}", 2)
    seen_names.add(source.name)

    sidecars = [
        candidate
        for candidate in source.parent.iterdir()
        if candidate.is_file()
        and candidate.stem.casefold() == source.stem.casefold()
        and candidate.suffix.casefold() == ".xmp"
    ]
    if len(sidecars) > 1:
        names = ", ".join(sorted(candidate.name for candidate in sidecars))
        error(f"Photo has multiple adjacent XMP sidecars: {source.name} ({names})")
    if sidecars:
        photo_sidecars[source] = sidecars[0]

with facts_template.open("r", encoding="utf-8") as handle:
    facts = yaml.safe_load(handle)
if not isinstance(facts, dict):
    error("Plant template facts.yaml must contain a YAML mapping")

facts["name"] = name
facts["slug"] = slug
facts["plant"]["type"] = plant_type
facts["rescue"]["date"] = onboarding_date
facts["status"]["current"] = status
facts["status"]["updated"] = datetime.date.fromisoformat(date_text)

if photo_sources:
    initial_photo = f"photos/{photo_sources[0].name}"
    facts["photos"]["hero"] = initial_photo
    facts["photos"]["current"] = initial_photo

plants_dir.mkdir(parents=True, exist_ok=True)
temporary = Path(tempfile.mkdtemp(prefix=f".{slug}-", dir=plants_dir))

try:
    for filename in (
        "story.md",
        "history.md",
        "inventory.md",
        "photo-metadata.md",
    ):
        shutil.copy2(template_dir / filename, temporary / filename)

    (temporary / "photos").mkdir()
    (temporary / "sources").mkdir()
    (temporary / "photos" / ".gitkeep").touch()
    (temporary / "sources" / ".gitkeep").touch()

    for source in photo_sources:
        shutil.copy2(source, temporary / "photos" / source.name)
        sidecar = photo_sidecars.get(source)
        if sidecar:
            shutil.copy2(sidecar, temporary / "photos" / sidecar.name)

    (temporary / "facts.yaml").write_text(
        yaml.safe_dump(facts, sort_keys=False),
        encoding="utf-8",
    )

    replacements = {
        "story.md": ("# Plant Story", f"# {name}"),
        "history.md": ("# Plant History", f"# {name}"),
        "inventory.md": ("# Plant Inventory", f"# {name} Inventory"),
        "photo-metadata.md": ("# Photo Metadata", f"# {name} Photo Metadata"),
    }
    for filename, (old, new) in replacements.items():
        path = temporary / filename
        text = path.read_text(encoding="utf-8")
        path.write_text(text.replace(old, new, 1), encoding="utf-8")

    os.replace(temporary, destination)
except BaseException:
    shutil.rmtree(temporary, ignore_errors=True)
    raise

print("Plant Workspace Created")
print("=======================")
print(f"Plant: {name} ({slug})")
print(f"Type: {plant_type}")
print(f"Status: {status}")
print(f"Date: {onboarding_date.isoformat()}")
print(f"Photos imported: {len(photo_sources)}")
print(f"XMP sidecars imported: {len(photo_sidecars)}")
print(f"Workspace: {destination}")
PY

    validate_plant "$slug"
}

update_plant() {
    local slug="${1:-}"

    if [[ -z "$slug" ]]; then
        echo "ERROR: Plant slug is required."
        echo
        usage
        return 2
    fi

    shift

    local photo=""
    local narrative=""
    local care=""
    local status=""
    local update_date="$(date +%F)"
    local dry_run=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --photo|--narrative|--care|--status|--date)
                if [[ $# -lt 2 ]]; then
                    echo "ERROR: $1 requires a value."
                    return 2
                fi
                case "$1" in
                    --photo) photo="$2" ;;
                    --narrative) narrative="$2" ;;
                    --care) care="$2" ;;
                    --status) status="$2" ;;
                    --date) update_date="$2" ;;
                esac
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            *)
                echo "ERROR: Unknown plant update option: $1"
                return 2
                ;;
        esac
    done

    if [[ -z "$photo" || -z "$narrative" ]]; then
        echo "ERROR: --photo and --narrative are required."
        return 2
    fi

    python3 - \
        "$REPO_DIR" "$slug" "$photo" "$narrative" "$care" \
        "$status" "$update_date" "$dry_run" <<'PY'
import datetime
import os
import re
import shutil
import sys
import tempfile
from pathlib import Path

import yaml

root = Path(sys.argv[1]).resolve()
slug = sys.argv[2]
photo = Path(sys.argv[3]).expanduser().resolve()
narrative = sys.argv[4].strip()
care = sys.argv[5].strip()
requested_status = sys.argv[6].strip().lower()
date_text = sys.argv[7]
dry_run = sys.argv[8] == "true"
plant_dir = root / "working" / "plants" / slug
facts_path = plant_dir / "facts.yaml"
history_path = plant_dir / "history.md"
photos_dir = plant_dir / "photos"


def error(message, status=1):
    print(f"ERROR: {message}")
    raise SystemExit(status)


if not plant_dir.is_dir() or not facts_path.is_file() or not history_path.is_file():
    error(f"Plant workspace is incomplete: {plant_dir}")

if not photo.is_file():
    error(f"Photo does not exist: {photo}")

if photo.suffix.lower() not in {".jpg", ".jpeg", ".png", ".webp"}:
    error("Photo must be a JPG, PNG, or WebP image")

try:
    update_date = datetime.date.fromisoformat(date_text)
except ValueError:
    error(f"Date must use YYYY-MM-DD: {date_text}", 2)

facts_text = facts_path.read_text(encoding="utf-8")
facts = yaml.safe_load(facts_text)
if not isinstance(facts, dict):
    error("facts.yaml must contain a YAML mapping")

current_status = str(facts.get("status", {}).get("current", "")).lower()
valid_statuses = {"recovering", "thriving", "blooming", "dormant", "deceased"}
new_status = requested_status or current_status
if new_status not in valid_statuses:
    error(
        "Status must be one of: " + ", ".join(sorted(valid_statuses)),
        2,
    )

history = history_path.read_text(encoding="utf-8")
heading = f"## {update_date.isoformat()} — Weekly Update"
if re.search(rf"^{re.escape(heading)}$", history, re.MULTILINE):
    error(f"A weekly update already exists for {update_date.isoformat()}")

safe_stem = re.sub(r"[^a-z0-9]+", "-", slug.lower()).strip("-")
destination_name = f"{safe_stem}-{update_date.isoformat()}{photo.suffix.lower()}"
destination = photos_dir / destination_name
if destination.exists() and photo != destination:
    error(f"Destination photo already exists: {destination}")

relative_photo = f"photos/{destination_name}"
entry = [
    heading,
    "",
    "### Photos",
    "",
    f"- {destination_name}",
    "",
    "### Observations",
    "",
    narrative,
]
if care:
    entry.extend(["", "### Care", "", care])
entry_text = "\n".join(entry) + "\n"

print("Plant Weekly Update")
print("===================")
print(f"Plant: {facts.get('name', slug)} ({slug})")
print(f"Date: {update_date.isoformat()}")
print(f"Photo: {photo}")
print(f"Current photo: {facts.get('photos', {}).get('current')} -> {relative_photo}")
print(f"Hero photo: {facts.get('photos', {}).get('hero')} (preserved)")
print(f"Status: {current_status} -> {new_status}")
print(f"Care note: {care or '(none)'}")

if dry_run:
    print("Result: DRY RUN; no files changed")
    print()
    print("History entry")
    print("-------------")
    print(entry_text.rstrip())
    raise SystemExit(0)

photos_dir.mkdir(parents=True, exist_ok=True)
if photo != destination:
    shutil.copy2(photo, destination)

def replace_nested_scalar(text, section, key, value):
    lines = text.splitlines(keepends=True)
    section_index = None

    for index, line in enumerate(lines):
        if line.rstrip("\r\n") == f"{section}:":
            section_index = index
            break

    if section_index is None:
        error(f"facts.yaml is missing section: {section}")

    for index in range(section_index + 1, len(lines)):
        line = lines[index]
        if line and not line[0].isspace():
            break
        if re.match(rf"^  {re.escape(key)}:\s*", line):
            ending = "\n" if line.endswith("\n") else ""
            lines[index] = f"  {key}: {value}{ending}"
            return "".join(lines)

    error(f"facts.yaml is missing field: {section}.{key}")


def replace_status_tag(text, old_status, new_status):
    if old_status == new_status:
        return text

    lines = text.splitlines(keepends=True)
    in_tags = False

    for index, line in enumerate(lines):
        stripped = line.rstrip("\r\n")
        if stripped == "tags:":
            in_tags = True
            continue
        if in_tags and line and not line[0].isspace():
            break
        if in_tags and stripped.strip() == f"- {old_status}":
            ending = "\n" if line.endswith("\n") else ""
            indent = line[: len(line) - len(line.lstrip())]
            lines[index] = f"{indent}- {new_status}{ending}"
            break

    return "".join(lines)


updated_facts = replace_nested_scalar(
    facts_text, "photos", "current", relative_photo
)
updated_facts = replace_nested_scalar(
    updated_facts, "status", "current", new_status
)
updated_facts = replace_nested_scalar(
    updated_facts, "status", "updated", update_date.isoformat()
)
updated_facts = replace_status_tag(
    updated_facts, current_status, new_status
)

with tempfile.NamedTemporaryFile(
    "w", encoding="utf-8", dir=facts_path.parent, delete=False
) as handle:
    handle.write(updated_facts)
    facts_temp = Path(handle.name)
os.replace(facts_temp, facts_path)

separator = "" if history.endswith("\n\n") else "\n"
with history_path.open("a", encoding="utf-8") as handle:
    handle.write(separator + "---\n\n" + entry_text)

print("Result: update applied")
PY

    if [[ "$dry_run" == false ]]; then
        validate_plant "$slug"
    fi
}

select_image_role() {
    local role="$1"
    local slug="${2:-}"

    if [[ -z "$slug" ]]; then
        echo "ERROR: Plant slug is required."
        echo
        usage
        return 2
    fi

    shift 2

    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-image" \
        select plant "$slug" \
        --role "$role" \
        "$@"
}

select_hero() {
    select_image_role hero "$@"
}

select_index() {
    select_image_role index "$@"
}

validate_plant() {
    local slug="${1:-}"

    if [[ -z "$slug" ]]; then
        echo "ERROR: Plant slug is required."
        echo
        usage
        exit 2
    fi

    local plant_dir="$PLANTS_DIR/$slug"
    local facts_file="$plant_dir/facts.yaml"

    echo "Plant Validation"
    echo "================"
    echo "Plant: $slug"
    echo

    echo "Directory"
    echo "---------"

    if [[ -d "$plant_dir" ]]; then
        ok "Plant directory exists: $plant_dir"
    else
        fail "Plant directory does not exist: $plant_dir"
        print_summary
        exit 1
    fi

    echo
    echo "Required Files"
    echo "--------------"

    local required_files=(
        "facts.yaml"
        "history.md"
        "story.md"
        "inventory.md"
        "photo-metadata.md"
    )

    local file
    for file in "${required_files[@]}"; do
        if [[ -f "$plant_dir/$file" ]]; then
            ok "$file"
        else
            fail "$file is missing"
        fi
    done

    echo
    echo "Required Directories"
    echo "--------------------"

    local required_dirs=(
        "photos"
        "sources"
    )

    local dir
    for dir in "${required_dirs[@]}"; do
        if [[ -d "$plant_dir/$dir" ]]; then
            ok "$dir/"
        else
            fail "$dir/ is missing"
        fi
    done

    echo
    echo "Facts"
    echo "-----"

    if [[ ! -f "$facts_file" ]]; then
        fail "Cannot validate facts because facts.yaml is missing"
        print_summary
        exit 1
    fi

    if ! python3 -c 'import yaml' >/dev/null 2>&1; then
        fail "Python module PyYAML is not installed"
        echo
        echo "Install it with:"
        echo "  python3 -m pip install --user pyyaml"
        print_summary
        exit 1
    fi

    local facts_output
    if ! facts_output="$(
        python3 - "$facts_file" "$plant_dir" <<'PY'
import re
import sys
from pathlib import Path

import yaml

facts_path = Path(sys.argv[1])
plant_dir = Path(sys.argv[2])

try:
    with facts_path.open("r", encoding="utf-8") as handle:
        data = yaml.safe_load(handle)
except yaml.YAMLError as exc:
    print(f"FAIL|facts.yaml contains invalid YAML: {exc}")
    sys.exit(0)
except OSError as exc:
    print(f"FAIL|Unable to read facts.yaml: {exc}")
    sys.exit(0)

if not isinstance(data, dict):
    print("FAIL|facts.yaml must contain a YAML mapping")
    sys.exit(0)

print("OK|facts.yaml parses successfully")


def get_value(path):
    value = data
    for key in path.split("."):
        if not isinstance(value, dict) or key not in value:
            return None
        value = value[key]
    return value


required = (
    "name",
    "slug",
    "plant.type",
    "status.current",
)

for field in required:
    value = get_value(field)
    if value is None or value == "":
        print(f"FAIL|Required field is missing or empty: {field}")
    else:
        print(f"OK|{field}: {value}")

optional = (
    "plant.genus",
    "plant.species",
    "rescue.date",
    "status.updated",
)

for field in optional:
    value = get_value(field)
    if value is None or value == "":
        print(f"WARN|Optional field is not set: {field}")
    else:
        print(f"OK|{field}: {value}")

slug = get_value("slug")
if slug and slug != plant_dir.name:
    print(
        f"FAIL|facts.yaml slug '{slug}' does not match directory "
        f"name '{plant_dir.name}'"
    )
elif slug:
    print("OK|Slug matches plant directory")

for field in ("photos.hero", "photos.current"):
    value = get_value(field)

    if value is None or value == "":
        print(f"WARN|Photo reference is not set: {field}")
        continue

    path = plant_dir / value

    if path.is_file():
        print(f"OK|{field} exists: {value}")
    else:
        print(f"FAIL|{field} does not exist: {value}")

index_value = get_value("photos.index")

if index_value:
    index_path = plant_dir / index_value

    if index_path.is_file():
        print(f"OK|photos.index exists: {index_value}")
    else:
        print(f"FAIL|photos.index does not exist: {index_value}")

photos_dir = plant_dir / "photos"

if photos_dir.is_dir():
    supported_extensions = {".jpg", ".jpeg", ".png", ".webp"}
    workspace_photos = {
        path.name: path
        for path in photos_dir.iterdir()
        if path.is_file()
        and not path.name.startswith("._")
        and path.suffix.lower() in supported_extensions
    }
    references = {}

    def add_reference(value, source):
        if not isinstance(value, str) or not value.strip():
            return
        name = Path(value.strip()).name
        if name.lower() == "example.jpg":
            return
        if Path(name).suffix.lower() not in supported_extensions:
            return
        references.setdefault(name, set()).add(source)

    for field in ("photos.hero", "photos.current", "photos.index"):
        value = get_value(field)
        if not value:
            continue
        relative = Path(value)
        if relative.is_absolute() or relative.parent != Path("photos"):
            print(
                f"FAIL|{field} must reference a direct child of photos/: {value}"
            )
        add_reference(value, f"facts.yaml {field}")

    markdown_tick = chr(96)
    photo_line_pattern = re.compile(
        rf"^\s*(?:-\s+|####\s+){markdown_tick}?"
        rf"([^{markdown_tick}]+\.(?:jpe?g|png|webp)){markdown_tick}?\s*$",
        re.IGNORECASE,
    )
    markdown_image_pattern = re.compile(
        r"!\[[^\]]*\]\(([^)]+\.(?:jpe?g|png|webp))\)",
        re.IGNORECASE,
    )

    for document in sorted(plant_dir.glob("*.md")):
        try:
            lines = document.read_text(encoding="utf-8").splitlines()
        except OSError as exc:
            print(f"FAIL|Unable to inspect photo references in {document.name}: {exc}")
            continue

        for line_number, line in enumerate(lines, start=1):
            line_match = photo_line_pattern.match(line)
            if line_match:
                add_reference(
                    line_match.group(1),
                    f"{document.name}:{line_number}",
                )

            for image_match in markdown_image_pattern.finditer(line):
                add_reference(
                    image_match.group(1),
                    f"{document.name}:{line_number}",
                )

            if line.lstrip().startswith("|"):
                cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
                if cells:
                    add_reference(
                        cells[0].strip(markdown_tick),
                        f"{document.name}:{line_number}",
                    )

    print(f"OK|Supported workspace photos indexed: {len(workspace_photos)}")

    missing_references = sorted(set(references) - set(workspace_photos))
    for name in missing_references:
        sources = ", ".join(sorted(references[name]))
        print(
            f"FAIL|Referenced photo does not exist in photos/: {name} "
            f"(referenced by {sources})"
        )
    if not missing_references:
        print("OK|All canonical photo references resolve")

    orphaned_photos = sorted(set(workspace_photos) - set(references))
    for name in orphaned_photos:
        print(f"WARN|Undocumented or orphaned photo: photos/{name}")
    if not orphaned_photos:
        print("OK|No undocumented or orphaned supported photos")

placeholder_markers = {
    "story.md": ("\nTODO\n",),
    "history.md": ("## Entry Template", "Describe the event."),
    "inventory.md": ("\nName:\n", "\nSpecies:\n"),
    "photo-metadata.md": ("| example.jpg | YYYY-MM-DD |",),
}

for filename, markers in placeholder_markers.items():
    document = plant_dir / filename
    if not document.is_file():
        continue
    try:
        text = document.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"FAIL|Unable to read {filename}: {exc}")
        continue
    if any(marker in text for marker in markers):
        print(f"WARN|{filename} still contains template placeholders")
PY
    )"; then
        fail "Unable to execute facts.yaml validation"
    else
        while IFS='|' read -r level message; do
            case "$level" in
                OK)
                    ok "$message"
                    ;;
                WARN)
                    warn "$message"
                    ;;
                FAIL)
                    fail "$message"
                    ;;
            esac
        done <<< "$facts_output"
    fi

    print_summary

    if ((fail_count > 0)); then
        exit 1
    fi
}

publish_plant() {
    local slug="${1:-}"

    if [[ -z "$slug" ]]; then
        echo "ERROR: Plant slug is required."
        echo
        usage
        exit 2
    fi

    local plant_dir="$PLANTS_DIR/$slug"
    local facts_file="$plant_dir/facts.yaml"
    local output_file
    local public_dir
    local manifest_file
    local staging_dir
    local staged_output
    local staged_public_dir
    local staged_manifest
    local publish_status
    local lock_dir
    local lock_cleanup

    echo "Plant Publishing"
    echo "================"
    echo "Plant: $slug"
    echo

    validate_plant "$slug"

    load_publish_target
    output_file="$CONTENT_DIR/$slug.md"
    public_dir="$PUBLIC_PLANTS_DIR/$slug"
    manifest_file="$PUBLICATION_MANIFEST_DIR/$slug.json"
    lock_dir="$PUBLIC_PLANTS_DIR/.${slug}.publish.lock"

    echo
    echo "Publishing"
    echo "----------"
    echo "Target project: $PUBLISH_TARGET_ROOT"

    if [[ ! -x "$IMAGE_DERIVATIVE_HELPER" ]]; then
        echo "ERROR: Public image helper is missing or not executable:"
        echo "  $IMAGE_DERIVATIVE_HELPER"
        return 1
    fi

    if ! command -v exiftool >/dev/null 2>&1; then
        echo "ERROR: ExifTool is required for plant publishing."
        return 1
    fi

    if ! command -v magick >/dev/null 2>&1 &&
       ! command -v convert >/dev/null 2>&1
    then
        echo "ERROR: ImageMagick is required for plant publishing."
        return 1
    fi

    mkdir -p "$CONTENT_DIR"
    mkdir -p "$PUBLIC_PLANTS_DIR"
    mkdir -p "$PUBLICATION_MANIFEST_DIR"
    if ! mkdir "$lock_dir" 2>/dev/null; then
        echo "ERROR: Plant publication is already in progress: $slug"
        return 1
    fi
    printf -v lock_cleanup 'rm -rf -- %q' "$lock_dir"
    trap "$lock_cleanup" EXIT INT TERM
    staging_dir="$(mktemp -d "$PUBLIC_PLANTS_DIR/.${slug}.publish.XXXXXX")"
    staged_output="$staging_dir/content.md"
    staged_public_dir="$staging_dir/public"
    staged_manifest="$staging_dir/manifest.json"
    mkdir -p "$staged_public_dir"

    set +e
    python3 - \
        "$facts_file" \
        "$plant_dir" \
        "$staged_output" \
        "$staged_public_dir" \
        "$IMAGE_DERIVATIVE_HELPER" \
        "$REPO_DIR" \
        "$PUBLISH_TARGET_ROOT" \
        "$staged_manifest" \
        "$public_dir" <<'PY'
import json
import re
import subprocess
import sys
from pathlib import Path

import yaml

facts_path = Path(sys.argv[1])
plant_dir = Path(sys.argv[2])
output_path = Path(sys.argv[3])
public_dir = Path(sys.argv[4])
image_helper = Path(sys.argv[5])
source_root = Path(sys.argv[6]).resolve()
target_root = Path(sys.argv[7]).resolve()
manifest_path = Path(sys.argv[8])
final_public_dir = Path(sys.argv[9])
source_config = yaml.safe_load(
    (source_root / ".abbey/project.yml").read_text(encoding="utf-8")
)
target_config = yaml.safe_load(
    (target_root / ".abbey/project.yml").read_text(encoding="utf-8")
)

publication_records = []

with facts_path.open("r", encoding="utf-8") as handle:
    facts = yaml.safe_load(handle)


def get(path, default=None):
    value = facts
    for key in path.split("."):
        if not isinstance(value, dict):
            return default
        value = value.get(key)
        if value is None:
            return default
    return value


def read_document(relative_path):
    path = plant_dir / relative_path
    text = path.read_text(encoding="utf-8").strip()

    lines = text.splitlines()

    if lines and lines[0].startswith("# "):
        lines = lines[1:]

        while lines and not lines[0].strip():
            lines.pop(0)

    return "\n".join(lines).strip()


def project_relative(path, root, label):
    resolved = Path(path).resolve()

    try:
        return str(resolved.relative_to(root))
    except ValueError as error:
        raise SystemExit(
            f"ERROR Publication {label} is outside its project: {resolved}"
        ) from error


def create_public_derivative(source, destination, publication):
    result = subprocess.run(
        [
            sys.executable,
            str(image_helper),
            str(source),
            str(destination),
            "--max-edge",
            "2400",
            "--quality",
            "85",
        ],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        message = f"ERROR Unable to publish image {source}"

        if detail:
            message += f":\n{detail}"

        raise SystemExit(message)

    try:
        record = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise SystemExit(
            f"ERROR Invalid provenance returned for image: {source}"
        ) from error

    record["source"]["path"] = project_relative(
        record["source"]["path"], source_root, "source"
    )
    record["derivative"]["path"] = project_relative(
        final_public_dir / destination.name, target_root, "derivative"
    )
    record["publication"] = publication
    publication_records.append(record)
    return record


def copy_public_image(field_name, public_name):
    relative_path = get(field_name)

    if not relative_path:
        return None

    source = plant_dir / relative_path
    destination = public_dir / f"{public_name}{source.suffix.lower()}"

    record = create_public_derivative(
        source,
        destination,
        {
            "type": "role",
            "name": public_name,
            "field": field_name,
        },
    )

    version = record["derivative"]["sha256"][:12]
    return f"/images/plants/{get('slug')}/{destination.name}?v={version}"


def publish_history_photos(markdown, plant_name, slug):
    photos_dir = plant_dir / "photos"
    image_files = {
        photo.name: photo
        for photo in photos_dir.iterdir()
        if photo.is_file()
        and photo.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp"}
    }

    published = {}
    output = []
    current_section = None

    photo_pattern = re.compile(
        r"^\s*(?:-\s+|####\s+)`?([^`]+\.(?:jpe?g|png|webp))`?\s*$",
        re.IGNORECASE,
    )

    for line in markdown.splitlines():
        if line.startswith("## "):
            current_section = line[3:].strip()

        match = photo_pattern.match(line)

        if not match:
            output.append(line)
            continue

        filename = match.group(1)
        source = image_files.get(filename)

        if source is None:
            output.append(line)
            continue

        if filename not in published:
            sequence = len(published) + 1
            destination = public_dir / (
                f"photo-{sequence:02d}{source.suffix.lower()}"
            )
            record = create_public_derivative(
                source,
                destination,
                {
                    "type": "history",
                    "name": f"photo-{sequence:02d}",
                    "source_filename": filename,
                },
            )
            version = record["derivative"]["sha256"][:12]
            published[filename] = (
                f"/images/plants/{slug}/{destination.name}?v={version}"
            )

        alt_text = (
            f"{plant_name} — {current_section}"
            if current_section
            else f"{plant_name} progress photograph"
        )

        output.append(f"![{alt_text}]({published[filename]})")

    return "\n".join(output), published

name = get("name")
slug = get("slug")
source_description = get("description")
plant_type = get("plant.type")
status = get("status.current")
genus = get("plant.genus")
species = get("plant.species")
acquired = get("rescue.date")
updated = get("status.updated")
tags = get("tags", [])

story_path = get("documents.story")
history_path = get("documents.history")

story = read_document(story_path)
history = read_document(history_path)

hero_image = copy_public_image("photos.hero", "hero")
current_image = copy_public_image("photos.current", "current")
index_image = copy_public_image("photos.index", "index")

history, history_images = publish_history_photos(
    history,
    name,
    slug,
)

species_label = genus
if species:
    species_label = f"{genus} {species}" if genus else species

description = source_description or (
    f"The rescue and recovery story of {name}, "
    f"a {species_label or plant_type} rescued from neglect."
)

frontmatter = {
    "title": name,
    "description": description,
    "type": plant_type,
    "status": status,
    "species": species_label,
    "acquired": acquired,
    "featured": True,
    "draft": False,
    "updatedDate": updated,
    "heroImage": hero_image,
    "currentImage": current_image,
    "indexImage": index_image,
    "tags": tags,
}

frontmatter = {
    key: value
    for key, value in frontmatter.items()
    if value is not None
}

body = f"""---
{yaml.safe_dump(frontmatter, sort_keys=False).strip()}
---

{story}

{history}
"""

output_path.write_text(body, encoding="utf-8")

publication_manifest = {
    "schema_version": 1,
    "source_project": {
        "slug": source_config["project"]["slug"],
    },
    "target_project": {
        "slug": target_config["project"]["slug"],
        "domain": target_config["site"]["publish"]["domain"],
    },
    "plant": {
        "slug": slug,
    },
    "profile": {
        "maximum_edge": 2400,
        "colorspace": "sRGB",
        "metadata_removed": True,
        "jpeg_quality": 85,
    },
    "images": publication_records,
}

manifest_path.parent.mkdir(parents=True, exist_ok=True)
manifest_path.write_text(
    json.dumps(
        publication_manifest,
        indent=2,
        sort_keys=True,
    ) + "\n",
    encoding="utf-8",
)

print(f"Generated content: {output_path}")
print(f"Generated publication manifest: {manifest_path}")
if hero_image:
    print(f"Published hero image: {hero_image}")
if current_image:
    print(f"Published current image: {current_image}")
if index_image:
    print(f"Published index image: {index_image}")
PY
    publish_status=$?
    set -e

    if ((publish_status != 0)); then
        rm -rf "$staging_dir"
        return "$publish_status"
    fi

    python3 - \
        "$PUBLISH_TARGET_ROOT" \
        "$public_dir" \
        "$manifest_file" \
        "$output_file" \
        "$staged_public_dir" \
        "$staged_manifest" \
        "$staged_output" <<'PY_COMMIT'
import json
import os
import shutil
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
public_dir = Path(sys.argv[2]).resolve()
manifest_path = Path(sys.argv[3]).resolve()
output_path = Path(sys.argv[4]).resolve()
staged_public_dir = Path(sys.argv[5]).resolve()
staged_manifest = Path(sys.argv[6]).resolve()
staged_output = Path(sys.argv[7]).resolve()


def managed_derivatives(path):
    if not path.is_file():
        return []
    data = json.loads(path.read_text(encoding="utf-8"))
    managed = []
    for record in data.get("images", []):
        relative = record.get("derivative", {}).get("path")
        if not relative:
            continue
        candidate = (root / relative).resolve()
        try:
            candidate.relative_to(public_dir)
        except ValueError as error:
            raise SystemExit(
                f"ERROR Manifest derivative is outside the plant public directory: {candidate}"
            ) from error
        managed.append(candidate)
    return managed


public_dir.mkdir(parents=True, exist_ok=True)
for old_derivative in managed_derivatives(manifest_path):
    if old_derivative.is_file() or old_derivative.is_symlink():
        old_derivative.unlink()

for staged_derivative in staged_public_dir.iterdir():
    os.replace(staged_derivative, public_dir / staged_derivative.name)

output_path.parent.mkdir(parents=True, exist_ok=True)
manifest_path.parent.mkdir(parents=True, exist_ok=True)
os.replace(staged_output, output_path)
os.replace(staged_manifest, manifest_path)
shutil.rmtree(staged_public_dir.parent)
PY_COMMIT

    echo
    echo "PASS Plant published successfully."
    rm -rf "$lock_dir"
    trap - EXIT INT TERM
}

publish_batch() {
    if [[ $# -eq 0 ]]; then
        echo "ERROR: At least one plant slug is required."
        echo
        usage
        return 2
    fi

    local total="$#"
    local index=0
    local slug

    echo "Plant Batch Publishing"
    echo "======================"
    echo "Plants: $total"
    echo "Mode: serialized"

    for slug in "$@"; do
        ((index += 1))
        echo
        echo "[$index/$total] Publishing $slug"
        echo
        "$0" publish "$slug"
    done

    echo
    echo "PASS Published $total plant(s) serially."
}

print_summary() {
    echo
    echo "Result"
    echo "------"
    printf 'OK: %d  WARN: %d  FAIL: %d\n' \
        "$ok_count" "$warn_count" "$fail_count"

    if ((fail_count > 0)); then
        echo "FAIL Plant model validation failed."
    elif ((warn_count > 0)); then
        echo "PASS Plant model validation completed with warnings."
    else
        echo "PASS Plant model validation completed successfully."
    fi
}

command="${1:-help}"

case "$command" in
    new)
        shift
        new_plant "$@"
        ;;
    validate)
        shift
        validate_plant "${1:-}"
        ;;
    publish)
        shift
        publish_plant "${1:-}"
        ;;
    publish-batch)
        shift
        publish_batch "$@"
        ;;
    hero)
        shift
        select_hero "$@"
        ;;
    index)
        shift
        select_index "$@"
        ;;
    update)
        shift
        update_plant "$@"
        ;;
    rename-exports)
        shift
        rename_exports "$@"
        ;;
    update-batch)
        shift
        update_batch "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown plant command: $command"
        echo
        usage
        exit 1
        ;;
esac
