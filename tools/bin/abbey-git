#!/usr/bin/env bash
# COMMAND: git
# DESCRIPTION: Audit and synchronize Git configuration across Abbey-managed hosts
set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
ABBEY_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

ANSIBLE_DIR="$ABBEY_ROOT/ansible"
INVENTORY_FILE="$ANSIBLE_DIR/inventory/hosts.yml"
AUDIT_PLAYBOOK="$ANSIBLE_DIR/playbooks/git-audit.yml"
SYNC_PLAYBOOK="$ANSIBLE_DIR/playbooks/git-sync.yml"
CONTROL_HOST="rocky-ansible01"

usage() {
  cat <<'USAGE'
Usage:
  abbey git audit [--limit HOST_OR_GROUP]
  abbey git sync [--check] [--limit HOST_OR_GROUP]
  abbey git help

Commands:
  audit    Verify global Git policy, repository remotes, and GitHub SSH access
  sync     Install global Git policy and normalize existing repository checkouts
  help     Show this help

Options:
  --check              Preview synchronization changes
  --limit TARGET       Restrict operation to a host or inventory group

Safety:
  Synchronization does not clone repositories, change branches, pull, push,
  commit, modify working files, or manage private SSH keys.
USAGE
}

fail() {
  printf 'FAIL %s\n' "$*" >&2
  exit 1
}

require_control_host() {
  local current_host

  current_host="$(hostname -s)"
  if [[ "$current_host" != "$CONTROL_HOST" ]]; then
    fail "Abbey Git management must run on $CONTROL_HOST (current: $current_host)."
  fi
}

require_environment() {
  command -v ansible-playbook >/dev/null 2>&1 ||
    fail "Required command not found: ansible-playbook"
  [[ -f "$INVENTORY_FILE" ]] ||
    fail "Inventory file not found: $INVENTORY_FILE"
}

run_playbook() {
  local playbook="$1"
  shift

  (
    cd "$ANSIBLE_DIR" || exit 1
    ANSIBLE_CONFIG="$ANSIBLE_DIR/ansible.cfg" \
      ansible-playbook \
        -i "$INVENTORY_FILE" \
        "$playbook" \
        "$@"
  )
}

run_git_workflow() {
  local command="$1"
  shift
  local target="all"
  local check_mode=false
  local -a playbook_args=()

  while (($#)); do
    case "$1" in
      --check)
        [[ "$command" == "sync" ]] || fail "--check is valid only with sync"
        check_mode=true
        shift
        ;;
      --limit)
        (($# >= 2)) || fail "--limit requires a value"
        target="$2"
        shift 2
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        fail "Unknown $command option: $1"
        ;;
    esac
  done

  require_control_host
  require_environment

  if [[ "$check_mode" == "true" ]]; then
    playbook_args+=(--check --diff)
  fi

  echo "========================================"
  echo " Abbey Root Git"
  echo "========================================"
  echo
  echo "Mode: $command"
  echo "Control host: $(hostname -s)"
  echo "Targets: $target"
  [[ "$command" == "sync" ]] && echo "Check mode: $check_mode"
  echo

  if [[ "$command" == "audit" ]]; then
    run_playbook "$AUDIT_PLAYBOOK" -e "abbey_git_targets=$target"
  else
    run_playbook \
      "$SYNC_PLAYBOOK" \
      -e "abbey_git_targets=$target" \
      "${playbook_args[@]}"
  fi
}

command="${1:-help}"
shift || true

case "$command" in
  audit|sync)
    run_git_workflow "$command" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown Git command: $command"
    echo
    usage
    exit 2
    ;;
esac
