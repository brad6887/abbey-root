#!/usr/bin/env bash
set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
ABBEY_TOOLKIT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
ABBEY_ROOT="$ABBEY_TOOLKIT_ROOT"

source "$ABBEY_TOOLKIT_ROOT/tools/lib/project.sh"
resolved_project_root="$(abbey_find_project_root "$PWD" || true)"
if [[ -n "$resolved_project_root" ]]; then
  ABBEY_ROOT="$resolved_project_root"
fi

export ABBEY_TOOLKIT_ROOT
export ABBEY_ROOT

command="${1:-help}"

case "$command" in
  project)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-project" "$@"
    ;;

  init)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-init" "$@"
    ;;

  doctor)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-doctor" "$@"
    ;;

  validate)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-validate" "$@"
    ;;
  git)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-git" "$@"
    ;;

  journal)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-journal" "$@"
    ;;

  ai)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-ai" "$@"
    ;;

  research)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-research" "$@"
    ;;

  status)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-status" "$@"
    ;;

  session)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-session" "$@"
    ;;

  end)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-end" "$@"
    ;;

  review)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-review" "$@"
    ;;

  next)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-next" "$@"
    ;;

  backlog)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-backlog" "$@"
    ;;

  docs)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-docs" "$@"
    ;;

  knowledge)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-knowledge" "$@"
    ;;

  site)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-site" "$@"
    ;;

  image)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-image" "$@"
    ;;

  media)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-media" "$@"
    ;;

  plant)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-plant" "$@"
    ;;

  lab)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-lab" "$@"
    ;;

  remote)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-remote" "$@"
    ;;

  ssh)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-ssh" "$@"
    ;;

  version)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-version" "$@"
    ;;

  context)
    shift
    "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-context" "$@"
    ;;    

  help|-h|--help)
    "$ABBEY_TOOLKIT_ROOT/scripts/abbey_cli.py" help
    ;;

  *)
    echo "Unknown command: $command"
    echo
    echo "Run 'abbey help' for available commands."
    exit 1
    ;;
esac
