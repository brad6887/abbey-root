#!/usr/bin/env bash
# COMMAND: end
# DESCRIPTION: Certify that the current Abbey session is complete
set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
ABBEY_TOOLKIT_ROOT="${ABBEY_TOOLKIT_ROOT:-$(cd "$SCRIPT_DIR/../.." && pwd)}"
ABBEY_ROOT="${ABBEY_ROOT:-$ABBEY_TOOLKIT_ROOT}"

source "$ABBEY_TOOLKIT_ROOT/tools/lib/project.sh"

ok_count=0
warning_count=0
failure_count=0

ok() {
  echo "OK   $*"
  ok_count=$((ok_count + 1))
}

warn() {
  echo "WARN $*"
  warning_count=$((warning_count + 1))
}

fail() {
  echo "FAIL $*"
  failure_count=$((failure_count + 1))
}

section() {
  echo
  echo "$1"
  printf '%*s\n' "${#1}" '' | tr ' ' '-'
}

is_reconciliation_only_commit() {
  local commit_hash="$1"
  local session_files="$2"
  local added_session_files
  local file
  local frontmatter
  local status
  local reviewed

  [[ -n "$session_files" ]] || return 1

  added_session_files="$(
    git -C "$ABBEY_ROOT" diff-tree \
      --no-commit-id \
      --name-only \
      --diff-filter=A \
      -r "$commit_hash" 2>/dev/null |
      grep -E '^docs/session-updates/[^/]+\.md$' || true
  )"

  [[ -z "$added_session_files" ]] || return 1

  while IFS= read -r file; do
    [[ -n "$file" ]] || continue

    if ! frontmatter="$(
      git -C "$ABBEY_ROOT" show "$commit_hash:$file" 2>/dev/null
    )"; then
      return 1
    fi

    status="$(
      awk -F':[[:space:]]*' '
        /^---[[:space:]]*$/ {
          delimiter_count += 1
          if (delimiter_count == 2) {
            exit
          }
          next
        }
        delimiter_count == 1 && $1 == "status" {
          print $2
          exit
        }
      ' <<<"$frontmatter"
    )"
    reviewed="$(
      awk -F':[[:space:]]*' '
        /^---[[:space:]]*$/ {
          delimiter_count += 1
          if (delimiter_count == 2) {
            exit
          }
          next
        }
        delimiter_count == 1 && $1 == "reviewed" {
          print $2
          exit
        }
      ' <<<"$frontmatter"
    )"

    [[ "$status" == "complete" && "$reviewed" == "true" ]] || return 1
  done <<<"$session_files"

  return 0
}

echo "========================================"
echo " Abbey End"
echo "========================================"
echo
echo "Date: $(date)"
echo "Host: $(hostname)"
echo "Repo: $ABBEY_ROOT"

section "Repository"

if ! git -C "$ABBEY_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  fail "Git repository not detected: $ABBEY_ROOT"
else
  ok "Git repository detected"

  branch="$(git -C "$ABBEY_ROOT" branch --show-current 2>/dev/null || true)"
  if [[ -n "$branch" ]]; then
    ok "Current branch: $branch"
  else
    fail "Unable to determine current branch"
  fi

  if [[ -z "$(git -C "$ABBEY_ROOT" status --porcelain 2>/dev/null)" ]]; then
    ok "Working tree clean"
  else
    fail "Working tree contains uncommitted changes"
  fi
fi

section "Latest Commit"

latest_commit="$(git -C "$ABBEY_ROOT" log -1 --format='%h %s' 2>/dev/null || true)"
latest_commit_hash="$(git -C "$ABBEY_ROOT" rev-parse HEAD 2>/dev/null || true)"

if [[ -n "$latest_commit" ]]; then
  ok "$latest_commit"
else
  fail "No commit found"
fi

section "Session Documentation"

commit_files=""
session_updates=""
journal_policy="$(
  abbey_project_value "$ABBEY_ROOT" "workflow.journal.policy" "required"
)"
if [[ -n "$latest_commit_hash" ]]; then
  commit_files="$(
    git -C "$ABBEY_ROOT" diff-tree \
      --no-commit-id \
      --name-only \
      -r "$latest_commit_hash" 2>/dev/null || true
  )"
fi

session_updates="$(
  grep -E '^docs/session-updates/[^/]+\.md$' <<<"$commit_files" || true
)"

if [[ -n "$session_updates" ]]; then
  session_update="$(
    head -1 <<<"$session_updates"
  )"
  ok "Session update committed: $session_update"
else
  fail "Latest commit does not contain a session update"
fi

if grep -Eq '^content/journal/.+\.md$' <<<"$commit_files"; then
  journal_entry="$(
    grep -E '^content/journal/.+\.md$' <<<"$commit_files" |
      head -1
  )"
  ok "Journal entry committed: $journal_entry"
else
  case "$journal_policy" in
    required)
      if is_reconciliation_only_commit "$latest_commit_hash" "$session_updates"; then
        ok "Journal entry not required for reconciliation-only commit"
      else
        fail "Latest commit does not contain a journal entry (policy: required)"
      fi
      ;;
    event-driven|optional)
      ok "Journal entry not required (policy: $journal_policy)"
      ;;
    *)
      fail "Unsupported journal policy: $journal_policy"
      ;;
  esac
fi

section "Validation"

if [[ -x "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-backlog" ]]; then
  if "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-backlog" check >/dev/null 2>&1; then
    ok "Generated backlog statistics are current"
  else
    fail "Generated backlog statistics are stale, malformed, or missing"
  fi
else
  fail "Abbey Backlog command not found"
fi

doctor_output=""
doctor_status=0

if [[ -x "$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-doctor" ]]; then
  doctor_output="$("$ABBEY_TOOLKIT_ROOT/tools/bin/abbey-doctor" 2>&1)" || doctor_status=$?

  doctor_failures="$(
    awk '/^Failures:[[:space:]]*/ {print $2}' <<<"$doctor_output" |
      tail -1
  )"

  if [[ "$doctor_failures" =~ ^[0-9]+$ ]]; then
    if (( doctor_failures == 0 )); then
      ok "Abbey Doctor reports no failures"
    else
      fail "Abbey Doctor reports $doctor_failures failure(s)"
    fi
  elif (( doctor_status == 0 )); then
    ok "Abbey Doctor completed successfully"
  else
    fail "Unable to verify Abbey Doctor result"
  fi
else
  fail "Abbey Doctor command not found"
fi

section "Remote"

behind=0
ahead=0
upstream="$(git -C "$ABBEY_ROOT" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)"

if [[ -z "$upstream" ]]; then
  warn "Current branch has no configured upstream"
else
  counts="$(
    git -C "$ABBEY_ROOT" rev-list \
      --left-right \
      --count "$upstream...HEAD" 2>/dev/null || true
  )"

  behind="${counts%%[[:space:]]*}"
  ahead="${counts##*[[:space:]]}"

  if [[ "$behind" =~ ^[0-9]+$ && "$ahead" =~ ^[0-9]+$ ]]; then
    if (( behind > 0 )); then
      fail "Branch is behind $upstream by $behind commit(s)"
    elif (( ahead > 0 )); then
      ok "Branch is ahead of $upstream by $ahead commit(s)"
    else
      ok "Branch is synchronized with $upstream"
    fi
  else
    warn "Unable to determine upstream branch status"
  fi
fi

section "Summary"

printf "%-10s %s\n" "OK:" "$ok_count"
printf "%-10s %s\n" "Warnings:" "$warning_count"
printf "%-10s %s\n" "Failures:" "$failure_count"

echo
echo "========================================"

if (( failure_count == 0 )); then
  echo " Session Complete"
  echo "========================================"
  echo

  if [[ "${ahead:-0}" =~ ^[0-9]+$ ]] && (( ahead > 0 )); then
    echo "Next recommended action:"
    echo
    echo "    git push"
  else
    echo "The session has been successfully concluded."
  fi

  exit 0
fi

echo " Session Incomplete"
echo "========================================"
echo
echo "Resolve the failures above, run abbey session review if changes are required,"
echo "commit the final session state, and run abbey end again."

exit 1
