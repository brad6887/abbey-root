FROM rockylinux/rockylinux:9
ARG ANSIBLE_CORE=2.16.16
RUN dnf install -y python3 python3.12 python3.12-pip openssh-server openssh-clients sudo shadow-utils \
    && dnf clean all
RUN python3.12 -m venv /opt/ansible \
    && /opt/ansible/bin/pip install --no-cache-dir ansible-core==${ANSIBLE_CORE}
ENV PATH="/opt/ansible/bin:${PATH}"
RUN mkdir -p /run/sshd /etc/sudoers.d && ssh-keygen -A
CMD ["python3", "/repo/tests/fixtures/contributor/lifecycle.py"]
