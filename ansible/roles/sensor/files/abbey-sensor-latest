#!/usr/bin/env python3
"""Display the latest Abbey environmental sensor reading."""

import json
from pathlib import Path


latest_path = Path("/var/lib/abbey-sensor/latest.json")
if not latest_path.exists():
    raise SystemExit("No sensor reading has been recorded yet.")

reading = json.loads(latest_path.read_text(encoding="utf-8"))
print(f"Time:        {reading['timestamp_utc']}")
print(f"Temperature: {reading['temperature_f']:.2f} °F ({reading['temperature_c']:.2f} °C)")
print(f"Humidity:    {reading['humidity_percent']:.2f}% RH")
print(f"Touch:       {reading['touch_value']}")
print(f"Sensor:      {reading['device_serial']}")
